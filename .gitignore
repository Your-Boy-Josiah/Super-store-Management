# ============================================================
#  .gitignore
#  Tells Git which files and folders to never track.
# ============================================================

# # Dependencies

# node_modules/

# # Environment variables & secrets (CRITICAL: never commit API keys or passwords)
# .env
# .env.local

# # Operating System & Editor metadata
# .DS_Store
# Thumbs.db
# .vscode/

# # Build outputs & logs
# dist/
# build/
# *.log

# ============================================================
# Node.js Dependencies
# ============================================================

# Installed packages — never commit these, they are restored with npm install
node_modules/

# npm and yarn cache directories
.npm
.yarn-integrity

# Packed npm release archives
*.tgz


# ============================================================
# Environment Variables & Secrets  (CRITICAL — never commit)
# ============================================================

.env
.env.local
.env.test
.env.development
.env.production

# Catch-all for any other .env files added in the future
.env*.local


# ============================================================
# Log Files
# ============================================================

# General log files
*.log

# npm and yarn specific debug and error logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# ============================================================
# Test Coverage Output
# ============================================================

# Generated when running test coverage reports (Jest, Mocha, etc.)
coverage/
.nyc_output/


# ============================================================
# Build & Compile Output
# ============================================================

# Compiled or transpiled output folders
dist/
build/


# ============================================================
# Editor & IDE Files
# ============================================================

# VS Code — only ignore user-specific workspace settings, not shared config
.vscode/settings.json
.vscode/launch.json

# JetBrains IDEs (WebStorm, IntelliJ)
.idea/

# ESLint cache generated during linting
.eslintcache


# ============================================================
# Operating System Metadata
# ============================================================

# macOS folder metadata files
.DS_Store

# Windows thumbnail cache files
Thumbs.db

# Windows desktop layout file
Desktop.ini


# ============================================================
# Misc Node.js Artifacts
# ============================================================

# REPL history saved when using the Node.js interactive shell
.node_repl_history

# Runtime process ID files
*.pid
*.pid.lock 

# Uploaded Files
uploads/

# Logs
npm-debug.log*
*.log

Test_Client.rest
frontend/dist/
